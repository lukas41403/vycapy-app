{
  "expo": {
    "name": "Výčapy-Opatovce",
    "slug": "vycapy-opatovce",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/erb.png",
    "scheme": "vycapyapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.vycapy.obecapp",
      "supportsTablet": true
    },
    "android": {
      "package": "com.vycapy.obecapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#C62828",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/erb.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C62828",
          "dark": {
            "backgroundColor": "#8E1F1F"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "vycapy-opatovce"
      }
    }
  }
}
